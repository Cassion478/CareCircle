# ==============================================================================
# CareCircle - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or expose production keys to Git.
#
# Obtain these values from your Supabase Project:
# Supabase Dashboard -> Project Settings -> API & Data API
# ==============================================================================

# Supabase Project REST API URL (Required)
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anonymous Key (Required)
# This key is safe to be exposed in the browser client with Row Level Security (RLS) enabled.
# It can be either the new standard publishable key or the legacy anon public key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional alias fallback for legacy anon key configuration
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
